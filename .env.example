# =========================================================================
# Airdrop Hunter — Environment Variables (EXAMPLE)
# =========================================================================
# Это ШАБЛОН. Скопируй его в .env и вставь свои значения:
#   cp .env.example .env
# .env НЕ коммитится в git (см. .gitignore).
# =========================================================================

# --- Общие настройки ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Telegram уведомления ---
# Создай бота через @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Прокси (опционально) ---
# Формат: http://user:pass@host:port или socks5://user:pass@host:port
PROXY_URL=

# --- RPC для блокчейна ---
# Публичные эндпоинты для Polygon
POLYGON_RPC_URL=https://polygon-rpc.com

# --- Капча (опционально) ---
# Для автоматического решения капчи
CAPTCHA_API_KEY=

# --- База данных ---
DATABASE_URL=sqlite:///./data/airdrop.db


# --- Шифрование приватных ключей ---
# Сгенерируй: python -c "import secrets; print(secrets.token_urlsafe(64))"
WALLET_ENCRYPTION_KEY=your_encryption_key_here

# --- Твой основной (cold) кошелёк ---
# Куда бот будет переводить заработанные токены. НЕ приватный ключ!
COLD_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
